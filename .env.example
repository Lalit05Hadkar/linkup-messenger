# InsForge Backend Configuration
INSFORGE_PROJECT_URL=https://<your-project-id>.us-east.insforge.app
INSFORGE_ANON_KEY=<your-insforge-anon-key>

# Gemini AI (Optional)
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# Release Signing Environment Variables (Required for release builds)
# STORE_PASSWORD=<keystore-password>
# KEY_PASSWORD=<key-password>
# KEYSTORE_PATH=<optional-path-to-jks>
